# Copy to .env and fill in. Every VITE_ value is compiled into the JavaScript
# sent to browsers: never put a real secret here.

# ============================================================
# Sign-in (OAuth 2.0 + PKCE) and CDP backend
# ============================================================

# CDP base URL: all REST calls (current user, templates) and image uploads
# (<base>/rest/files) go here
VITE_OAUTH_BASE_URL=https://your-tenant.example.com

# OAuth client ID of the report studio app (defaults to "vim-18" when empty)
VITE_OAUTH_CLIENT_ID=

# Authorize, token and current-user endpoints
VITE_OAUTH_AUTH_URL=https://your-tenant.example.com/oauth/authorize
VITE_OAUTH_TOKEN_URL=https://your-tenant.example.com/oauth/token
VITE_OAUTH_USER_URL=https://your-tenant.example.com/oauth/user

# Where the browser goes after logout
VITE_OAUTH_LOGOUT_URI=http://localhost:1420/login

# ============================================================
# PDF preview server (Preview PDF): reports are posted to
# <url>/api/pdf/generateForm
# ============================================================
VITE_PDF_PREVIEW_API=https://preview.report.projectnowcdp.com

# ============================================================
# AI Assistant (any OpenAI-compatible API)
# ============================================================
# Uses the local LM Studio API by default

# AI service URL (defaults to the local LM Studio API)
VITE_AI_API_ENDPOINT=http://127.0.0.1:1234/v1

