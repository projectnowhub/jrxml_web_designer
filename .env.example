# Copy to .env and fill in. Every VITE_ value is compiled into the JavaScript
# sent to browsers: never put a real secret here.

# ============================================================
# Sign-in (OAuth 2.0 + PKCE) and CDP backend
# ============================================================

# CDP server: every API is this address plus its route (src/config/apiConfig.ts):
# /oauth2/authorize, /oauth2/token, /v1/user/me, /logout, /rest/files (images),
# /v2 (report server), /v2/analytics/aggregate (charts), /v2/table/{entity} (lists such as the projects)
VITE_API_BASE_URL=https://your-tenant.example.com

# OAuth client ID of the report studio app (defaults to "vim-18" when empty)
VITE_OAUTH_CLIENT_ID=
